package {{basePackage}}.infrastructure.config;

import org.springframework.boot.autoconfigure.condition.ConditionalOnMissingClass;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.transaction.PlatformTransactionManager;
import org.springframework.transaction.TransactionDefinition;
import org.springframework.transaction.support.AbstractPlatformTransactionManager;
import org.springframework.transaction.support.DefaultTransactionStatus;

/**
 * Placeholder transaction manager for the in-memory phase: no resource is transactional yet, but
 * {@code @Transactional} must be live so that transaction synchronisation (after-commit event
 * listeners) runs. Replace with the data starter's manager when persistence arrives, and delete
 * this class.
 *
 * <p>It steps aside by itself once {@code spring-jdbc} is on the class path: a bean of the project's
 * would otherwise make the data starter's auto-configured manager back off, and real writes would run
 * without a transaction that can roll back.
 *
 * <p>It lives below the global infrastructure package on purpose: DCA-LAY-004 allows transaction
 * manager wiring in {@code <base>.infrastructure..} (the composition root) and in the shared kernel's
 * infrastructure package.
 */
@ConditionalOnMissingClass("org.springframework.jdbc.datasource.DataSourceTransactionManager")
@Configuration(proxyBeanMethods = false)
class InMemoryTransactionManagerConfiguration {

  @Bean
  PlatformTransactionManager transactionManager() {
    return new AbstractPlatformTransactionManager() {
      @Override
      protected Object doGetTransaction() {
        return new Object();
      }

      @Override
      protected void doBegin(Object transaction, TransactionDefinition definition) {}

      @Override
      protected void doCommit(DefaultTransactionStatus status) {}

      @Override
      protected void doRollback(DefaultTransactionStatus status) {}
    };
  }
}
