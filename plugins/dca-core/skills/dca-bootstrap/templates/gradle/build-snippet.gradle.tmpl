// Add to the dependencies block of build.gradle (Groovy DSL) — the building blocks the
// production code implements: AggregateRoot, Entity, Value, DomainEvent, UseCase, Repository, …
dependencies {
  implementation 'dev.domaincentric:dca-building-blocks:{{dcaBuildingBlocksVersion}}'
  // Spring only: DomainEventPublisher + TransactionBoundary implementations, auto-configured
  implementation 'dev.domaincentric:dca-spring:{{dcaSpringVersion}}'
}

