// DCA architecture governance: a dedicated source set and task for the rule catalog.
// Installed by the dca-bootstrap skill.
//
// Apply from your build.gradle:
//   apply from: "gradle/plugins/test-architecture.gradle"
//
// Run with:
//   ./gradlew test-architecture

sourceSets {
  testArchitecture {
    java.srcDir file("src/test-architecture/java")
    resources.srcDir file("src/test-architecture/resources")
  }
}

configurations {
  testArchitectureImplementation.extendsFrom(implementation)
  testArchitectureRuntimeOnly.extendsFrom(runtimeOnly)
}

dependencies {
  testArchitectureImplementation sourceSets.main.output
  // The DCA rule catalog; brings ArchUnit transitively
  testArchitectureImplementation "dev.domaincentric:dca-archunit:{{dcaJavaVersion}}"
  testArchitectureImplementation "org.junit.jupiter:junit-jupiter:{{junitVersion}}"
  testArchitectureRuntimeOnly "org.junit.platform:junit-platform-launcher"
{{#if springModulithEnabled}}
  // Spring Modulith structure verification (SpringModulithVerificationTest)
  testArchitectureImplementation "org.springframework.modulith:spring-modulith-starter-test"
{{/if}}
}

tasks.register('test-architecture', Test) {
  description = 'Runs the DCA architecture rules'
  group = 'verification'
  testClassesDirs = sourceSets.testArchitecture.output.classesDirs
  classpath = sourceSets.testArchitecture.runtimeClasspath
  useJUnitPlatform()
}

// Make `check` run the architecture suite too. Without this the rules only run when
// somebody types the task by hand, which is not governance — it is a suggestion.
tasks.named('check') { dependsOn 'test-architecture' }
