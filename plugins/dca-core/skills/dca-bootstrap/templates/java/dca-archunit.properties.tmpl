# Domain-Centric Architecture rule selection (dev.domaincentric:dca-archunit).
# Read by DcaArchitectureTest from the test class path; ArchitectureTest.additionalSelection()
# is merged on top, the later entry wins per rule id. An unknown id or set name fails the run.
#
# Sets: cycles, layered, onion, hexagonal, naming, tactical, strategic, contextmap, advanced, usecase,
#       errors.

# Which sets run (omit the key to run the whole catalog).
dca.rules.sets = {{ruleSets}}

# Switched off, with the reason — stays in the report as skipped.
#dca.rules.off               = DCA-NAM-002
#dca.rule.DCA-NAM-002.reason = no DI framework in this project

# Reported but not failing the build — for rules the team is working towards.
{{#if noLayeredModuleYet}}
# DCA-STR-012: no context has a domain/application/adapter layer yet, so every layer-selecting
# rule passes without looking at anything. Remove this entry once the first aggregate or use case
# exists (/dca-scaffold does that for you).
dca.rules.warn              = DCA-STR-012
{{else}}
#dca.rules.warn              = DCA-TAC-009
{{/if}}
#dca.rules.warn.sets         = naming

# A documented exception: violations matching the pattern are ignored for that rule.
#dca.rule.DCA-STR-003.ignore = .*legacy.*

# Baseline: existing violations are frozen, only new ones fail (single ArchUnit rules only).
#dca.rules.freeze            = DCA-ONI-002
#dca.rules.freeze.store      = arch/frozen
