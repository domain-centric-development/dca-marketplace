package {{basePackage}};

import static org.junit.jupiter.api.Assertions.assertNotNull;

import org.junit.jupiter.api.Test;
import org.springframework.modulith.core.ApplicationModules;

/**
 * Spring Modulith module structure verification: no undeclared cross-module dependencies, named
 * interfaces ({@code api/}, {@code events/}) configured, {@code allowedDependencies} respected.
 *
 * <p>Not an ArchUnit rule — Modulith's own analyzer over its own model, which is why it is a test
 * class of its own next to the DCA catalog. Requires {@code spring-modulith-starter-test}.
 */
class SpringModulithVerificationTest {

  private static final ApplicationModules MODULES =
      ApplicationModules.of(ArchitectureTest.BASE_PACKAGE);

  @Test
  void applicationModuleStructureIsValid() {
    MODULES.verify();
  }

  @Test
  void applicationModulesAreDiscovered() {
    // Zero modules is legitimate right after bootstrap (no bounded contexts yet).
    assertNotNull(MODULES.stream().toList());
  }
}
