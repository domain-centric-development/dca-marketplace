 * </pre>
 *
 * <p><b>References:</b>
 *
 * <ul>
 *   <li>Alistair Cockburn - Hexagonal Architecture (Ports & Adapters)
 *   <li>Robert C. Martin - Clean Architecture
 * </ul>
 */
