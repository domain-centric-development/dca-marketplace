package {{basePackage}}

import com.tngtech.archunit.base.DescribedPredicate
import com.tngtech.archunit.core.domain.JavaClass
import org.springframework.modulith.core.ApplicationModules
import spock.lang.Shared
import spock.lang.Specification

/**
 * Spring Modulith module structure verification test.
 *
 * Validates that all application modules respect their declared boundaries:
 * - No undeclared cross-module dependencies
 * - Named interfaces (api/, events/) are properly configured
 * - Module allowedDependencies are respected
 */
class SpringModulithVerificationTest extends Specification {

  // Test classes living directly in the base package (this test, the ArchUnit suite, the
  // Initializr smoke test) would otherwise be picked up as a synthetic "root" module.
  // Match on the full name incl. inner/closure classes (FooTest$1, FooTest$_check_closure1):
  // a simpleName check misses them and Modulith then reports the root module depending on
  // non-exposed sharedkernel types.
  @Shared
  ApplicationModules modules = ApplicationModules.of(
    "{{basePackage}}",
    DescribedPredicate.describe("test classes", { JavaClass c ->
      c.name.matches(/.*Tests?(\$.*)?/)
    } as java.util.function.Predicate))

  def "Application module structure should be valid"() {
    expect:
    modules.verify()
  }

  def "Diagnostic: Display discovered application modules"() {
    when:
    def moduleList = modules.stream().toList()

    // Printing stays in when: — `.each {}` in then: would be asserted and an empty list is falsy
    println "=== Spring Modulith Application Modules ==="
    moduleList.each { module ->
      println "  ${module.displayName}: ${module.basePackage}"
      module.namedInterfaces.each { ni ->
        println "    Named Interface: ${ni.name} -> ${ni}"
      }
    }
    println "============================================"

    then:
    // Zero modules is legitimate right after bootstrap (no bounded contexts yet)
    moduleList != null
  }
}
