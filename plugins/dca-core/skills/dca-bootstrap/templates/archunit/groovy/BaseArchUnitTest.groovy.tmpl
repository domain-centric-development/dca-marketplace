package {{basePackage}}

import com.tngtech.archunit.base.DescribedPredicate
import com.tngtech.archunit.core.domain.JavaClass
import com.tngtech.archunit.core.domain.JavaClasses
import com.tngtech.archunit.core.importer.ClassFileImporter
import com.tngtech.archunit.core.importer.ImportOption
import com.tngtech.archunit.core.importer.Location
import {{boundedContextAnnotationFqn}}
import {{openHostServiceAnnotationFqn}}
import {{sharedKernelAnnotationFqn}}
import spock.lang.Shared
import spock.lang.Specification

import java.util.regex.Pattern

/**
 * Base class for all DCA ArchUnit tests.
 *
 * The CONFIGURATION block below is populated by the dca-bootstrap skill at install time.
 * All other rule classes (DddTacticalPatternsArchUnitTest, HexagonalArchitectureArchUnitTest, etc.)
 * inherit these constants — never hardcode FQNs in the rule classes.
 */
abstract class BaseArchUnitTest extends Specification {

  // ============================================================================
  // CONFIGURATION — populated by dca-bootstrap skill
  // ============================================================================

  /** Base package of the application under test (e.g. "com.acme.shop"). */
  protected static final String BASE_PACKAGE = "{{basePackage}}"

  /** Sharedkernel marker package root (e.g. "com.acme.shop.sharedkernel.marker"). */
  protected static final String SHARED_KERNEL_MARKER_PACKAGE = "{{sharedKernelPackage}}"

  /** Layer subpackage names — adapt if the project uses different conventions. */
  protected static final String DOMAIN_SUBPKG         = "{{domainSubpackage}}"          // typically "domain"
  protected static final String APP_SUBPKG            = "{{appSubpackage}}"              // typically "application"
  protected static final String ADAPTER_SUBPKG        = "{{adapterSubpackage}}"          // typically "adapter"
  protected static final String INCOMING_SUBFOLDER    = "{{incomingSubfolder}}"          // "incoming" (DCA) or "in" (Hombergs-style)
  protected static final String OUTGOING_SUBFOLDER    = "{{outgoingSubfolder}}"          // "outgoing" (DCA) or "out" (Hombergs-style)
  protected static final String INFRASTRUCTURE_SUBPKG = "{{infrastructureSubpackage}}"   // typically "infrastructure"

  /** Marker classes — may be DCA-installed or the project's existing markers (mapped at install time). */
  protected static final Class<?> AGGREGATE_ROOT_MARKER     = {{aggregateRootMarkerFqn}}.class
  protected static final Class<?> ENTITY_MARKER             = {{entityMarkerFqn}}.class
  protected static final Class<?> VALUE_MARKER              = {{valueMarkerFqn}}.class
  protected static final Class<?> ID_MARKER                 = {{idMarkerFqn}}.class
  protected static final Class<?> REPOSITORY_MARKER         = {{repositoryMarkerFqn}}.class
  protected static final Class<?> STORE_MARKER              = {{storeMarkerFqn}}.class
  protected static final Class<?> USE_CASE_MARKER           = {{useCaseMarkerFqn}}.class
  protected static final Class<?> INPUT_PORT_MARKER         = {{inputPortMarkerFqn}}.class
  protected static final Class<?> OUTPUT_PORT_MARKER        = {{outputPortMarkerFqn}}.class
  protected static final Class<?> DOMAIN_EVENT_MARKER       = {{domainEventMarkerFqn}}.class
  protected static final Class<?> INTEGRATION_EVENT_MARKER  = {{integrationEventMarkerFqn}}.class
  protected static final Class<?> DOMAIN_SERVICE_MARKER     = {{domainServiceMarkerFqn}}.class
  protected static final Class<?> FACTORY_MARKER            = {{factoryMarkerFqn}}.class
  protected static final Class<?> SPECIFICATION_MARKER      = {{specificationMarkerFqn}}.class
  protected static final Class<? extends java.lang.annotation.Annotation> BOUNDED_CONTEXT_ANNOTATION = BoundedContext
  protected static final Class<? extends java.lang.annotation.Annotation> SHARED_KERNEL_ANNOTATION   = SharedKernel
  protected static final Class<? extends java.lang.annotation.Annotation> OPEN_HOST_SERVICE_ANNOTATION = OpenHostService

  /** Use-case implementation suffix — "UseCase" (DCA), "ApplicationService" (Hombergs), or "Service" (Spring). */
  protected static final String USE_CASE_IMPL_SUFFIX = "{{useCaseImplSuffix}}"

  /** REST controller suffix — "Resource" (REST best practice) or "Controller" (Spring convention). */
  protected static final String REST_CONTROLLER_SUFFIX = "{{restControllerSuffix}}"

  /** Third-party packages allowed inside the domain layer (must remain framework-independent). */
  protected static final List<String> THIRD_PARTY_PACKAGES_ALLOWED_IN_DOMAIN = List.of(
      "java..",
      "lombok..",
      "org.apache.commons.lang3..",
      "org.apache.commons.collections4",
      "org.jspecify.annotations.."
  )

  // ============================================================================
  // DERIVED PATTERNS — do not change unless your project layout differs.
  // ============================================================================

  protected static final String SHAREDKERNEL_PACKAGE                 = "${SHARED_KERNEL_MARKER_PACKAGE}.."
  protected static final String SHAREDKERNEL_MARKER_TACTICAL_PACKAGE  = "${SHARED_KERNEL_MARKER_PACKAGE}.tactical.."
  protected static final String SHAREDKERNEL_MARKER_STRATEGIC_PACKAGE = "${SHARED_KERNEL_MARKER_PACKAGE}.strategic.."
  protected static final String SHAREDKERNEL_MARKER_PORT_PACKAGE      = "${SHARED_KERNEL_MARKER_PACKAGE}.port.."
  protected static final String SHAREDKERNEL_MARKER_PORT_IN_PACKAGE   = "${SHARED_KERNEL_MARKER_PACKAGE}.port.in.."
  protected static final String SHAREDKERNEL_MARKER_PORT_OUT_PACKAGE  = "${SHARED_KERNEL_MARKER_PACKAGE}.port.out.."

  /** Generic per-context patterns (matches every bounded context). */
  protected static final String DOMAIN_PACKAGE_PATTERN          = "${BASE_PACKAGE}.*.${DOMAIN_SUBPKG}.."
  protected static final String DOMAIN_MODEL_PACKAGE_PATTERN    = "${BASE_PACKAGE}.*.${DOMAIN_SUBPKG}.model.."
  protected static final String APPLICATION_PACKAGE_PATTERN     = "${BASE_PACKAGE}.*.${APP_SUBPKG}.."
  protected static final String ADAPTER_PACKAGE_PATTERN         = "${BASE_PACKAGE}.*.${ADAPTER_SUBPKG}.."
  protected static final String INCOMING_ADAPTER_PACKAGE_PATTERN = "${BASE_PACKAGE}.*.${ADAPTER_SUBPKG}.${INCOMING_SUBFOLDER}.."
  protected static final String OUTGOING_ADAPTER_PACKAGE_PATTERN = "${BASE_PACKAGE}.*.${ADAPTER_SUBPKG}.${OUTGOING_SUBFOLDER}.."
  protected static final String INFRASTRUCTURE_PACKAGE          = "${BASE_PACKAGE}.${INFRASTRUCTURE_SUBPKG}.."

  /** Short-form aliases for backward compatibility with rule classes. */
  protected static final String DOMAIN_PACKAGE          = DOMAIN_PACKAGE_PATTERN
  protected static final String DOMAIN_MODEL_PACKAGE    = DOMAIN_MODEL_PACKAGE_PATTERN
  protected static final String APPLICATION_PACKAGE     = APPLICATION_PACKAGE_PATTERN
  protected static final String ADAPTER_PACKAGE         = ADAPTER_PACKAGE_PATTERN
  protected static final String INCOMING_ADAPTER_PACKAGE = INCOMING_ADAPTER_PACKAGE_PATTERN
  protected static final String OUTGOING_ADAPTER_PACKAGE = OUTGOING_ADAPTER_PACKAGE_PATTERN

  /** Predicate for infrastructure implementation classes that adapters must NOT depend on directly. */
  protected static final DescribedPredicate<JavaClass> INFRASTRUCTURE_IMPLEMENTATION =
      DescribedPredicate.describe(
          "reside in infrastructure implementation",
          { JavaClass javaClass ->
            javaClass.getPackageName().startsWith("${BASE_PACKAGE}.${INFRASTRUCTURE_SUBPKG}.")
          }
      )

  /**
   * Excludes test code from the imported set: test JARs (e.g. *-test.jar from testArtifacts config)
   * and classes compiled to test output directories.
   */
  static class DoNotIncludeTestCode implements ImportOption {
    private Pattern testJarPattern = Pattern.compile(".*-test\\.jar!.*")
    private Pattern testClassesPattern = Pattern.compile(".*/build/classes/([^/]+/)?test.*/.*")

    @Override
    boolean includes(Location location) {
      return !location.matches(testJarPattern) && !location.matches(testClassesPattern)
    }
  }

  /**
   * Includes only project module JARs (from build/libs/) and class directories.
   * Excludes third-party JARs from Gradle/Maven caches and wrapper directories.
   * This is critical for multi-module projects where bounded context discovery
   * requires scanning classes from sibling module JARs.
   */
  static class OnlyProjectJars implements ImportOption {
    private Pattern thirdPartyJarPattern = Pattern.compile(".*/caches|wrapper/.*\\.jar!.*")

    @Override
    boolean includes(Location location) {
      return !location.matches(thirdPartyJarPattern)
    }
  }

  /** All production classes (excluding tests and third-party JARs). Shared across all architecture tests. */
  @Shared
  protected JavaClasses allClasses = new ClassFileImporter()
      .withImportOption(ImportOption.Predefined.DO_NOT_INCLUDE_TESTS)
      .withImportOption(new DoNotIncludeTestCode())
      .withImportOption(new OnlyProjectJars())
      .importPackages(BASE_PACKAGE)

  // ============================================================================
  // BOUNDED CONTEXT DISCOVERY UTILITIES
  // ============================================================================

  /** Discovers all packages annotated with @BoundedContext. */
  protected Map<String, BoundedContext> discoverBoundedContextPackages() {
    Map<String, BoundedContext> contexts = [:]
    allClasses.each { javaClass ->
      String packageName = javaClass.getPackageName()
      String rootPackage = extractRootContextPackage(packageName)
      if (rootPackage && !contexts.containsKey(rootPackage)) {
        def annotation = getPackageAnnotation(rootPackage, BOUNDED_CONTEXT_ANNOTATION)
        if (annotation != null) {
          contexts[rootPackage] = annotation
        }
      }
    }
    return contexts
  }

  /** Discovers the package annotated with @SharedKernel, or null if none. */
  protected String discoverSharedKernelPackage() {
    Set<String> checked = [] as Set
    for (def javaClass : allClasses) {
      String rootPackage = extractRootContextPackage(javaClass.getPackageName())
      if (rootPackage && !checked.contains(rootPackage)) {
        checked.add(rootPackage)
        if (getPackageAnnotation(rootPackage, SHARED_KERNEL_ANNOTATION) != null) {
          return rootPackage
        }
      }
    }
    return null
  }

  protected <T extends java.lang.annotation.Annotation> T getPackageAnnotation(String packageName, Class<T> annotationType) {
    try {
      Class<?> packageInfoClass = Thread.currentThread().getContextClassLoader()
          .loadClass(packageName + ".package-info")
      return packageInfoClass.getAnnotation(annotationType)
    } catch (ClassNotFoundException ignored) {
      return null
    }
  }

  /** "com.acme.shop.product.domain.model" -> "com.acme.shop.product" (or null if not under BASE_PACKAGE). */
  protected String extractRootContextPackage(String fullPackageName) {
    if (!fullPackageName.startsWith(BASE_PACKAGE + ".")) return null
    String remainder = fullPackageName.substring((BASE_PACKAGE + ".").length())
    int dotIndex = remainder.indexOf('.')
    if (dotIndex > 0) return BASE_PACKAGE + "." + remainder.substring(0, dotIndex)
    if (remainder.length() > 0) return BASE_PACKAGE + "." + remainder
    return null
  }

  /** Extracts the short context name from a full package path, e.g. "com.acme.shop.cart" -> "cart". */
  protected String extractContextName(String packagePath) {
    return packagePath.substring(packagePath.lastIndexOf('.') + 1)
  }

  /** All bounded-context package patterns (with ".." suffix) for ArchUnit rules. */
  protected List<String> getBoundedContextPackagePatterns() {
    return discoverBoundedContextPackages().keySet().collect { it + ".." }
  }

  /** All bounded-context patterns except a specific one (used for cross-context isolation rules). */
  protected List<String> getBoundedContextPackagePatternsExcluding(String excludePackage) {
    return discoverBoundedContextPackages().keySet()
        .findAll { it != excludePackage }
        .collect { it + ".." }
  }

  /** Same as above but as an array (some ArchUnit APIs need varargs). */
  protected String[] getBoundedContextPackagePatternsArray() {
    return getBoundedContextPackagePatterns().toArray(new String[0])
  }

  protected String[] getBoundedContextDomainPatterns() {
    return discoverBoundedContextPackages().keySet().collect { "${it}.${DOMAIN_SUBPKG}..".toString() }.toArray(new String[0])
  }

  protected String[] getBoundedContextDomainModelPatterns() {
    return discoverBoundedContextPackages().keySet().collect { "${it}.${DOMAIN_SUBPKG}.model..".toString() }.toArray(new String[0])
  }

  protected String[] getBoundedContextApplicationPatterns() {
    return discoverBoundedContextPackages().keySet().collect { "${it}.${APP_SUBPKG}..".toString() }.toArray(new String[0])
  }

  protected String[] getBoundedContextAdapterPatterns() {
    return discoverBoundedContextPackages().keySet().collect { "${it}.${ADAPTER_SUBPKG}..".toString() }.toArray(new String[0])
  }

  /**
   * Extra non-context application packages (e.g. a "backoffice" or "admin" module that has
   * application code but is not modeled as a bounded context). Populated by the dca-bootstrap
   * skill when the project has such modules; empty by default.
   */
  protected static final List<String> EXTRA_APPLICATION_PACKAGES = List.of({{extraApplicationPackages}})
  protected static final List<String> EXTRA_ADAPTER_PACKAGES     = List.of({{extraAdapterPackages}})

  /** Sharedkernel domain package pattern (universal — present in every DCA project). */
  protected static final String SHAREDKERNEL_DOMAIN_PACKAGE = "${BASE_PACKAGE}.{{sharedKernelRoot}}.${DOMAIN_SUBPKG}.."

  /** Domain-model patterns for all bounded contexts plus shared kernel. */
  protected String[] allDomainModelPatternsWithSharedKernel() {
    def patterns = getBoundedContextDomainModelPatterns().toList()
    patterns.add(SHAREDKERNEL_DOMAIN_PACKAGE)
    return patterns.toArray(new String[0])
  }

  /** Domain patterns (full domain layer, not just model) for all contexts plus shared kernel. */
  protected String[] allDomainPatternsWithSharedKernel() {
    def patterns = getBoundedContextDomainPatterns().toList()
    patterns.add(SHAREDKERNEL_DOMAIN_PACKAGE)
    return patterns.toArray(new String[0])
  }

  /** Application patterns for all contexts plus extra modules (e.g. backoffice). */
  protected String[] allApplicationPatterns() {
    def patterns = getBoundedContextApplicationPatterns().toList()
    patterns.addAll(EXTRA_APPLICATION_PACKAGES)
    return patterns.toArray(new String[0])
  }

  /** Adapter patterns for all contexts plus extra modules. */
  protected String[] allAdapterPatterns() {
    def patterns = getBoundedContextAdapterPatterns().toList()
    patterns.addAll(EXTRA_ADAPTER_PACKAGES)
    return patterns.toArray(new String[0])
  }

  /**
   * Incoming adapter patterns for all contexts PLUS the shared kernel's incoming adapter
   * package (if it exists). Cross-cutting Response classes (ErrorResponse, base Response,
   * generic SimpleResponse, etc.) typically live in the shared kernel adapter — without
   * including it, rules that check for `*Response` placement will miss them.
   *
   * <p>The shared kernel package is discovered dynamically via the {@code @SharedKernel}
   * annotation on its package-info.java — works regardless of whether the package is named
   * {@code shared}, {@code common}, {@code core}, or {@code sharedkernel}.
   */
  protected String[] allIncomingAdapterPatterns() {
    def patterns = discoverBoundedContextPackages().keySet().collect {
      "${it}.${ADAPTER_SUBPKG}.${INCOMING_SUBFOLDER}..".toString()
    }
    String sharedKernelPkg = discoverSharedKernelPackage()
    if (sharedKernelPkg != null) {
      patterns.add("${sharedKernelPkg}.${ADAPTER_SUBPKG}.${INCOMING_SUBFOLDER}..".toString())
    }
    return patterns.toArray(new String[0])
  }

  /** Outgoing adapter patterns for all contexts plus the shared kernel's outgoing adapter package. */
  protected String[] allOutgoingAdapterPatterns() {
    def patterns = discoverBoundedContextPackages().keySet().collect {
      "${it}.${ADAPTER_SUBPKG}.${OUTGOING_SUBFOLDER}..".toString()
    }
    String sharedKernelPkg = discoverSharedKernelPackage()
    if (sharedKernelPkg != null) {
      patterns.add("${sharedKernelPkg}.${ADAPTER_SUBPKG}.${OUTGOING_SUBFOLDER}..".toString())
    }
    return patterns.toArray(new String[0])
  }
}
