<!-- dca-bootstrap: DCA building blocks + rule catalog (Maven).
     Insert into pom.xml. The architecture test lives in src/test/java/{{basePackagePath}}/ArchitectureTest.java
     and dca-archunit.properties in src/test/resources/. -->

<properties>
  <dca-building-blocks.version>{{dcaBuildingBlocksVersion}}</dca-building-blocks.version>
  <dca-spring.version>{{dcaSpringVersion}}</dca-spring.version>
  <dca-archunit.version>{{dcaJavaVersion}}</dca-archunit.version>
  <dca-archunit-spring-modulith.version>{{dcaModulithVersion}}</dca-archunit-spring-modulith.version>
</properties>

<dependencies>
  <!-- The building blocks the production code implements -->
  <dependency>
    <groupId>dev.domaincentric</groupId>
    <artifactId>dca-building-blocks</artifactId>
    <version>${dca-building-blocks.version}</version>
  </dependency>
  <!-- Spring: DomainEventPublisher + TransactionBoundary implementations, auto-configured -->
  <dependency>
    <groupId>dev.domaincentric</groupId>
    <artifactId>dca-spring</artifactId>
    <version>${dca-spring.version}</version>
  </dependency>
  <!-- The rule catalog; brings ArchUnit transitively -->
  <dependency>
    <groupId>dev.domaincentric</groupId>
    <artifactId>dca-archunit</artifactId>
    <version>${dca-archunit.version}</version>
    <scope>test</scope>
  </dependency>
  <dependency>
    <groupId>org.junit.jupiter</groupId>
    <artifactId>junit-jupiter</artifactId>
    <scope>test</scope>
  </dependency>
{{#if springModulithEnabled}}
  <!-- Spring Modulith verification: ModulithTest extends DcaSpringModulithTest -->
  <dependency>
    <groupId>dev.domaincentric</groupId>
    <artifactId>dca-archunit-spring-modulith</artifactId>
    <version>${dca-archunit-spring-modulith.version}</version>
    <scope>test</scope>
  </dependency>
  <dependency>
    <groupId>org.springframework.modulith</groupId>
    <artifactId>spring-modulith-starter-test</artifactId>
    <scope>test</scope>
  </dependency>
{{/if}}
</dependencies>

<!-- Surefire runs *Test classes by default, so ArchitectureTest, ContextMapDocumentationTest and
     ModulithTest need no extra include. To run only the architecture rules:
       mvn test -Dtest='ArchitectureTest' -->
